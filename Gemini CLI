        match severity {
            Severity::LowRisk => self.low_risk += 1,
            Severity::MediumRisk => self.medium_risk += 1,
            Severity::HighRisk => self.high_risk += 1,
        }
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ReportableFinding {
    pub path: PathBuf,
    pub message: String,
    pub severity: Severity,
    pub line: Option<usize>,
    pub source: Option<String>,
}

#[derive(Debug)]
pub struct ProbeResult {
    pub probe_name: String,
    pub findings: Vec<ReportableFinding>,
}

#[derive(Debug)]
pub struct Report {
    pub stats: Stats,
    pub results: Vec<ProbeResult>,
}

pub struct ReportBuilder<'a> {
    probe_findings: Vec<(&'a str, Vec<Finding>)>,
}

impl<'a> ReportBuilder<'a> {
    pub fn new() -> Self {
        Self {
            probe_findings: Vec::new(),
        }
    }

    pub fn add_probe_findings(&mut self, probe_name: &'a str, findings: Vec<Finding>) {
        if !findings.is_empty() {
            self.probe_findings.push((probe_name, findings));
        }
    }

    pub fn build(self) -> Report {
        let mut stats = Stats::default();
        let mut results = Vec::new();

        for (probe_name, findings) in self.probe_findings {
            let mut reportable_findings: Vec<ReportableFinding> = findings
                .iter()
                .map(|f| {
                    stats.inc(&f.severity);
                    f.for_report()
                })
                .collect();

            reportable_findings.sort_by_key(|f| f.severity);
            reportable_findings.reverse();

            results.push(ProbeResult {
                probe_name: probe_name.to_string(),
                findings: reportable_findings,
            });
        }

        Report { stats, results }
    }
}

