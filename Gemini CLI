use num_cpus;

pub(crate) struct DirEntry(jwalk::DirEntry<((), ())>);

impl From<jwalk::DirEntry<((), ())>> for DirEntry {
    fn from(entry: jwalk::DirEntry<((), ())>) -> Self {
        DirEntry(entry)
    }
}

impl DirEntry {
    pub(crate) fn path(&self) -> PathBuf {
        self.0.path()
    }

    pub(crate) fn file_type(&self) -> std::fs::FileType {
        self.0.file_type()
    }

    pub(crate) fn file_name(&self) -> &OsStr {
        self.0.file_name()
    }
}

pub(crate) struct Scanner {
    probes: Vec<Box<dyn Probe>>,
}

impl Scanner {
    pub fn with_probes(probes: Vec<Box<dyn Probe>>) -> Self {
        Scanner { probes }
    }

    pub(crate) fn scan<P: AsRef<Path>>(
        &mut self,
        scan_dir: P,
        scan_message: impl Into<String>,
        parallelism: Option<usize>,
    ) -> eros::Result<Vec<Finding>> {
        let num_threads = parallelism.unwrap_or_else(num_cpus::get);

        let mut pool = ThreadPoolBuilder::new();
        pool = match num_threads {
            0 => bail!("Parallelism cannot be set to zero"),
            1 => pool.use_current_thread().num_threads(1),
            _ => pool.num_threads(num_threads),
        };

        let pool = pool.build().context("Failed to build thread pool")?;
        let pool = Arc::new(pool);

        let busy_timeout = Some(Duration::from_millis(100));
        let walker = WalkDirGeneric::<((), ())>::new(&scan_dir);
        let walker = match num_threads {
            1 => walker.parallelism(Parallelism::Serial),
            _ => walker.parallelism(Parallelism::RayonExistingPool {
                pool: pool.clone(),
                busy_timeout,
            }),
        };

        let scan_message = scan_message.into();
        let walk_style = crate::indikatif::spinners::point()
            .template("{msg:.blue} {spinner}")
            .unwrap();

        let walk_progress = ProgressBar::new_spinner();
        walk_progress.enable_steady_tick(Duration::from_millis(100));

        // Pass 1: Selection
        walker
            .into_iter()
            .progress_with(walk_progress)
            .with_prefix("📂")
            .with_message(scan_message.clone())
            .with_finish(ProgressFinish::AndLeave)
            .with_style(walk_style)
            .filter_map(|e| e.ok())
            .for_each(|e| {
                let entry = DirEntry::from(e);
                for probe in self.probes.iter_mut() {
                    probe.select(&entry);
                }
            });

        // Pass 2: Scanning
        let multi_progress = MultiProgress::new();
        multi_progress.set_alignment(indicatif::MultiProgressAlignment::Bottom);

        let findings_by_probe =
            pool.scope(|s| -> Vec<eros::Result<Vec<Finding>>> {
                let mut results = Vec::new();
                for probe in &self.probes {
                    let task = s.spawn(|_| probe.scan_suspects(&multi_progress));
                    results.push(task);
                }
                results.into_iter().map(|t| t.join().unwrap()).collect()
            });

        let mut all_findings = Vec::new();
        for result in findings_by_probe {
            match result {
                Ok(findings) => all_findings.extend(findings),
                Err(e) => {
                    // Consider how to handle failing probes. For now, we'll print an error.
                    eprintln!("A probe failed during the scan: {}", e);
                }
            }
        }

        Ok(all_findings)
    }
}

