        );
        progress_bar.enable_steady_tick(Duration::from_millis(80));
        progress_bar.set_length(self.suspects.len() as u64);

        let findings = self
            .suspects
            .par_iter()
            .progress_with(progress_bar)
            .filter_map(|path| scan(&path))
            .collect::<Vec<_>>();

        Ok(findings)
    }
